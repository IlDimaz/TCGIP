# ===== TCGIP — configurazione d'ambiente (copia in .env in locale,
# o imposta le stesse variabili sulla piattaforma di deploy) =====

# Chiave segreta di Django: genera una con
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=tuo-secret-key-lunghissimo

# DEBUG: True solo in sviluppo locale. Default "safety-first":
# in produzione (DATABASE_URL presente) se NON imposti questa variabile,
# DEBUG viene forzato a False automaticamente.
DJANGO_DEBUG=False

# Host consentiti (separati da virgola), es. tcgip.onrender.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dominio principale dell'app (usato per ALLOWED_HOSTS e redirect) — opzionale
DJANGO_APP_DOMAIN=

# Origini fidate per la protezione CSRF (separate da virgola),
# es. https://tcgip.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tcgip.onrender.com

# Database. In locale lascia vuoto (usa sqlite); in produzione:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
# (il driver psycopg è già tra le dipendenze)
DATABASE_URL=

# Live/morti: log level (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO

# Chiave Pokémon TCG API (opzionale, per rate limit più alti)
POKEMON_TCG_API_KEY=

# Forza redirect HTTPS + cookie sicuri (default attivi quando DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
